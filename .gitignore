# ============================================================
# Universal .gitignore for the Neuro-Diet project
# (React Native / Expo frontend in neuro-diet/, FastAPI/Python
# backend in neuro-diet-backend/)
# ============================================================

# ---------- Frontend (Node / Expo / Metro) ----------
node_modules/
.expo/
dist/
web-build/
expo-env.d.ts
*.tsbuildinfo
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.*

# Native folders generated by `expo prebuild` (not needed for managed workflow)
/neuro-diet/ios
/neuro-diet/android
.kotlin/

# Signing / credentials that should never be committed
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.keystore

# ---------- Backend (Python) ----------
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Raw source datasets for the ETL pipeline (USDA FoodData Central, FooDB) -
# these are multi-gigabyte public downloads, not project source. The
# pre-built neuro_diet.db shipped in neuro-diet-backend/ is intentionally
# NOT ignored below, so the app runs out of the box without them.
neuro-diet-backend/data/

# ---------- Environment / secrets ----------
.env
.env.*
!.env.example

# ---------- Editors / OS ----------
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# ---------- Local tool / assistant config ----------
# Claude Code project config (e.g. launch.json for the dev-server preview) -
# local tooling setup, not app source.
.claude/
*.claude

# ---------- Logs ----------
*.log